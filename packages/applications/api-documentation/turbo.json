{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "src/**/*.{ts,tsp}",
        "!src/**/*.d.ts",
        "!src/generated/**",
        "tspconfig.yaml",
        "scripts/**"
      ],
      "outputs": ["dist/**", "src/generated/**"]
    }
  }
}
